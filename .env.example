OPENAI_API_KEY=请填写你的OpenAI_API_KEY
DATABASE_URL=mysql+pymysql://medical_user:medical_password@mysql:3306/medical_health?charset=utf8mb4
MYSQL_DATABASE=medical_health
MYSQL_USER=medical_user
MYSQL_PASSWORD=medical_password
MYSQL_ROOT_PASSWORD=medical_root_password
REDIS_URL=redis://redis:6379/0
# 知识库状态缓存的有效期，资料变更或重建后会立即清除。
# KNOWLEDGE_STATUS_CACHE_TTL_SECONDS=30
# 同一账号与来源 IP 每分钟允许的登录请求数；永久失败锁定仍由 MySQL 负责。
# LOGIN_RATE_LIMIT_PER_MINUTE=30
# 只有使用代理或第三方兼容接口时才取消注释并填写
# OPENAI_BASE_URL=https://你的接口地址/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
CHROMA_DIR=chroma_db
# 重建任务超过这个秒数仍未结束时自动标记为失败，默认 1800 秒（30 分钟）。
# REBUILD_JOB_TIMEOUT_SECONDS=1800
# 登录安全：令牌默认 7 天，同一账号最多保留 5 个有效会话；连续 5 次失败后锁定 15 分钟。
# SESSION_DAYS=7
# MAX_ACTIVE_SESSIONS=5
# MAX_LOGIN_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# Docker Compose 启动时会自动改用容器内的数据目录，无需手动填写 DATABASE_URL。
# 如 Docker 无法联网，可在 Linux 运行前设置：
# export DOCKER_HTTP_PROXY=http://host.docker.internal:代理端口
# export DOCKER_HTTPS_PROXY=http://host.docker.internal:代理端口
